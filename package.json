{
  "name": "form-electronics-demo",
  "version": "0.2.0",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node --import tsx scripts/validate-catalog.ts && next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
